# Copy to deploy.env.local (Git-ignored) and fill in before running deploy/publish.sh.
# Credentials can also come from AWS_PROFILE or the ambient AWS environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Required by deploy/publish.sh.
S3_BUCKET=

# Optional overrides.
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_PUBLIC_URL=https://example.com
# S3_ACL=public-read
# DIST_DIR=dist
